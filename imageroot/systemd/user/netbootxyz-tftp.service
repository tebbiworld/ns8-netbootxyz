# TFTP boot server (and optional proxyDHCP) for netboot.xyz. Runs dnsmasq from
# the netboot.xyz image in the host network namespace: TFTP data transfers use
# ephemeral ports and proxyDHCP needs to see LAN broadcasts, neither of which
# survives rootless port forwarding. NethServer lowers
# net.ipv4.ip_unprivileged_port_start to 23, so the rootless container can bind
# 67/udp, 69/udp and 4011/udp. dnsmasq refuses to start DHCP without
# CAP_NET_ADMIN and CAP_NET_RAW; in a rootless container these only apply inside the
# module's user namespace, so they grant no control over the host network.
#
# state/dnsmasq.conf is generated by configure-module: empty means TFTP only
# (the LAN DHCP server points clients here with options 66/67), otherwise it
# holds the proxyDHCP settings.

[Unit]
Description=netboot.xyz TFTP/proxyDHCP server
After=network-online.target netbootxyz.service
Wants=network-online.target

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=30
ExecStartPre=/bin/touch %S/state/dnsmasq.conf
ExecStartPre=/bin/rm -f %t/netbootxyz-tftp.pid %t/netbootxyz-tftp.ctr-id
# The image creates its unprivileged "nbxyz" user (uid 1000, owner of the TFTP
# files; dnsmasq --tftp-secure only serves files owned by it) in its init script,
# which this container skips, so create it before starting dnsmasq.
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/netbootxyz-tftp.pid \
    --cidfile %t/netbootxyz-tftp.ctr-id \
    --cgroups=no-conmon \
    --replace -d --name netbootxyz-tftp \
    --network=host \
    --cap-add=NET_ADMIN \
    --cap-add=NET_RAW \
    --volume netbootxyz-config:/config:z \
    --volume %S/state/dnsmasq.conf:/ns8/dnsmasq.conf:ro,z \
    --entrypoint /bin/sh \
    ${NETBOOTXYZ_IMAGE} \
    -c "getent group 1000 >/dev/null || groupadd -g 1000 nbxyz; getent passwd 1000 >/dev/null || useradd -u 1000 -g 1000 -d /config -s /bin/false nbxyz; exec /usr/local/bin/dnsmasq-wrapper.sh --conf-file=/ns8/dnsmasq.conf"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/netbootxyz-tftp.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/netbootxyz-tftp.ctr-id
PIDFile=%t/netbootxyz-tftp.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
