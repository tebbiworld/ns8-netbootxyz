{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get netboot.xyz configuration",
    "$id": "http://schema.nethserver.org/netbootxyz/get-configuration-output.json",
    "type": "object",
    "required": ["host", "admin_user", "admin_password_set", "pxe_server_ip", "proxy_dhcp", "uefi_boot_mode", "networks", "dhcp_options"],
    "properties": {
        "host": {"type": "string"},
        "http2https": {"type": "boolean"},
        "lets_encrypt": {"type": "boolean"},
        "admin_user": {"type": "string"},
        "admin_password_set": {"type": "boolean"},
        "ip_allowlist": {"type": "array", "items": {"type": "string"}},
        "pxe_server_ip": {"type": "string"},
        "proxy_dhcp": {"type": "boolean"},
        "uefi_boot_mode": {"type": "string", "enum": ["standard", "secureboot"]},
        "networks": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "interface": {"type": "string"},
                    "address": {"type": "string"},
                    "prefixlen": {"type": "integer"},
                    "network": {"type": "string"},
                    "dynamic": {"type": "boolean"}
                }
            }
        },
        "dhcp_options": {
            "type": "object",
            "properties": {
                "option66": {"type": "string"},
                "option67_uefi": {"type": "string"},
                "option67_bios": {"type": "string"}
            }
        },
        "url": {"type": "string"}
    }
}
