# Copy the settings of the original instance. The web password comes back with
# the restored state/htpasswd. PXE_SERVER_IP is only copied when this node owns
# that address: after a restore to another node the default of the new instance
# (the address of the node's default route) is the right one.

import json
import subprocess
import sys

import agent

request = json.load(sys.stdin)
if "environment" in request:
    # restore-module: the environment of the backup comes with the request
    env = request["environment"]
else:
    # clone-module (this file is linked there as 20copyenv): the core imports only
    # the variables the new instance does not have yet, so everything preset by
    # create-module would keep its default. The core leaves the source instance's
    # environment in state/environment.clone-module until its last step.
    env = agent.read_envfile("environment.clone-module")

KEEP = ["TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT", "ADMIN_USER", "IP_ALLOWLIST",
        "PROXY_DHCP", "UEFI_BOOT_MODE"]
values = {k: env[k] for k in KEEP if k in env}

pxe_ip = env.get("PXE_SERVER_IP", "")
if pxe_ip:
    local = subprocess.run(["ip", "-o", "-4", "addr", "show"], capture_output=True, text=True).stdout
    if f" {pxe_ip}/" in local:
        values["PXE_SERVER_IP"] = pxe_ip
    else:
        print(f"PXE server address {pxe_ip} is not on this node: keeping the default of the new instance", file=sys.stderr)

agent.mset_env(values)
