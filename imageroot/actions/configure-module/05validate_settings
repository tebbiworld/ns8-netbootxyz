# Semantic validation the JSON schema cannot express.

import os
import sys
import json
import ipaddress

import agent
import netbootxyz_net

agent.set_weight(os.path.basename(__file__), 0)  # validation step, no progress weight

data = json.load(sys.stdin)
errors = []


def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})


# The boot server address must belong to this node, otherwise clients would be
# sent to a TFTP server that does not exist.
server_ip = data["pxe_server_ip"]
if netbootxyz_net.find_network(server_ip) is None:
    fail("pxe_server_ip", server_ip, "pxe_server_ip_not_on_node")

for cidr in data.get("ip_allowlist", []):
    try:
        ipaddress.ip_network(cidr.strip(), strict=False)
    except ValueError:
        fail("ip_allowlist", cidr, "invalid_cidr")

# Exposing the web app requires a password: it can rewrite the boot menus every
# PXE client on the network runs.
htpasswd = os.path.join(os.environ.get("AGENT_STATE_DIR", "."), "htpasswd")
has_password = os.path.exists(htpasswd) and os.path.getsize(htpasswd) > 0
if data.get("host") and not data.get("admin_password") and not has_password:
    fail("admin_password", "", "admin_password_required")
if data.get("admin_password") and len(data["admin_password"]) < 8:
    fail("admin_password", "", "admin_password_too_short")

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(3)
