# Enable and (re)start both services so the new htpasswd and dnsmasq.conf take
# effect.

import subprocess

units = ["netbootxyz.service", "netbootxyz-tftp.service"]
subprocess.run(["systemctl", "--user", "enable", *units], check=True)
subprocess.run(["systemctl", "--user", "restart", *units], check=True)
